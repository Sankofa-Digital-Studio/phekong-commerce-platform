{
  "name": "phekong-commerce-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --configLoader runner",
    "test:run": "vitest run --configLoader runner",
    "supabase:version": "supabase --version",
    "supabase:start": "supabase start --ignore-health-check --exclude analytics,vector",
    "supabase:m0:check": "node scripts/validate-supabase-m0.mjs",
    "supabase:m0:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-supabase-m0.ps1",
    "supabase:m0:unix": "bash ./scripts/validate-supabase-m0.sh",
    "supabase:m0:ci": "bash ./scripts/validate-supabase-m0.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --configLoader runner --project=storybook",
    "storybook:ci": "npm run test-storybook && npm run build-storybook",
    "test:e2e:cypress": "cypress run --browser chrome",
    "e2e:cypress:open": "cypress open",
    "dependencies:check": "npm ls --all",
    "images:check": "node scripts/validate-image-pipeline.mjs",
    "images:prepare": "node scripts/prepare-image.mjs"
  },
  "dependencies": {
    "@emnapi/runtime": "1.11.2",
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.3",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/eslintrc": "^3.3.6",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/nextjs-vite": "^10.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "cypress": "^15.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-storybook": "^10.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.0",
    "storybook": "^10.5.0",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
