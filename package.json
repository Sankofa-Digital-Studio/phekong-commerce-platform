{
  "name": "phekong-commerce-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --configLoader runner",
    "test:run": "vitest run --configLoader runner",
    "supabase:version": "supabase --version",
    "supabase:start": "supabase start --ignore-health-check --exclude analytics,vector",
    "supabase:m0:check": "node scripts/validate-supabase-m0.mjs",
    "supabase:m0:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-supabase-m0.ps1",
    "supabase:m0:unix": "bash ./scripts/validate-supabase-m0.sh",
    "supabase:m0:ci": "bash ./scripts/validate-supabase-m0.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --configLoader runner --project=storybook",
    "storybook:ci": "npm run test-storybook && npm run build-storybook",
    "test:e2e:cypress": "cypress run --browser chrome",
    "e2e:cypress:open": "cypress open"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.110.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/eslintrc": "^3.3.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/browser": "3.2.6",
    "@vitest/coverage-v8": "3.2.6",
    "cypress": "^15.18.1",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.1",
    "eslint-plugin-storybook": "^10.4.6",
    "jsdom": "^26.0.0",
    "playwright": "^1.61.0",
    "storybook": "^10.4.6",
    "supabase": "2.109.0",
    "typescript": "^5.8.2",
    "vite": "8.0.16",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
